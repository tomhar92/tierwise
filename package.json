{
  "name": "tierwise",
  "version": "0.2.1",
  "description": "Cache-aware model tier router for Claude Code",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "tierwise": "dist/bin/router.js",
    "tierwise-report": "dist/bin/report.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --import tsx --test $(find test -name '*.test.ts')",
    "start": "tsx src/server.ts",
    "report": "tsx bin/report.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
